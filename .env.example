# EHR server session signing secret.
# Production/deployed environments require a random value of at least 32 characters.
# Local development may use an ephemeral process-only secret when this is blank;
# those development sessions intentionally stop working after the server restarts.
# Never commit the real secret.
EHR_SESSION_SECRET=

# First-party usernames/password hashes are provisioned into the server-side auth
# store; plaintext passwords do not belong in environment files or the repository.
# Future OAuth/SSO provider settings belong here as integrations are selected.
# Do not store real credentials in this file.

# Absolute path to the clinical SQLite database.
# Development defaults to ./data/ehr.db. Production requires this to be set to an
# absolute path: a path derived from the working directory silently moves — or is
# created empty — when the service is restarted from somewhere else.
# EHR_DATABASE_PATH=/var/lib/ehr/clinical.db

# Zero-cost local AI (Ollama). Clinical Bond defaults to the local Ollama daemon at
# 127.0.0.1 and llama3.2:1b. The configured model must actually be installed before
# the UI reports Ollama as inference-ready. OLLAMA_KEEP_ALIVE keeps the model loaded
# between clinical requests so repeated omnibox/scribe work does not pay cold-load
# latency each time. Set AI_PROVIDER=ehr-local to force the conservative rule-based
# fallback even when Ollama is available.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_KEEP_ALIVE=30m
# AI_PROVIDER=ollama
